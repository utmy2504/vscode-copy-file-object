{
  "name": "copy-file-object",
  "displayName": "Copy Finder File Object",
  "description": "Copy files from VS Code as macOS Finder file objects.",
  "version": "0.0.1",
  "publisher": "mymy0205",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:copyFileObject.copy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copyFileObject.copy",
        "title": "Copy Finder File Object"
      }
    ],
    "keybindings": [
      {
        "command": "copyFileObject.copy",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "copyFileObject.copy",
          "when": "resourceScheme == file",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "Copy Finder File Object",
      "properties": {
        "copyFileObject.showSuccessMessage": {
          "type": "boolean",
          "default": false,
          "description": "Show a notification after copying a file object to the clipboard."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "keywords": [
    "macos",
    "finder",
    "clipboard",
    "copy",
    "file"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/utmy2504/vscode-copy-file-object.git"
  }
}
